# DISABLED — 2026-08-18
#
# The live site is no longer served from public_html/ as flat static files.
# It now runs via a Node.js app (editor-server.js) through Phusion Passenger,
# configured in a .htaccess that lives only on the server and is managed by
# that app — not by this repo. If this workflow ran again, its FTP sync would
# overwrite that .htaccess, strip out the PassengerAppRoot directives, and
# likely take the live site down.
#
# This file is deliberately:
#   1. Moved out of .github/workflows/ so GitHub Actions no longer sees it
#      as a workflow at all (a push here cannot trigger it).
#   2. Disabled server-side via `gh workflow disable` (persists independent
#      of file content/location; requires an explicit `gh workflow enable`
#      to undo — a plain push will not re-enable it).
#
# Do not move this back into .github/workflows/ or re-enable it without
# first confirming how it should coexist with the current Node.js/Passenger
# deployment.

name: Deploy to Hostinger via FTP

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build Eleventy site
        run: npm run build

      - name: Deploy to Hostinger via FTP
        uses: SamKirkland/FTP-Deploy-Action@v4.3.5
        with:
          server: ${{ secrets.FTP_HOST }}
          username: ${{ secrets.FTP_USERNAME }}
          password: ${{ secrets.FTP_PASSWORD }}
          port: ${{ secrets.FTP_PORT || 21 }}
          protocol: ftp
          local-dir: ./dist/
          server-dir: ${{ secrets.FTP_REMOTE_ROOT || '/public_html/' }}
          exclude: |
            reach/**
            **/reach/**
            **/.DS_Store
            **/Thumbs.db
            **/node_modules/**
